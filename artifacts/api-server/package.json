{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_ENV=test node --import tsx/esm --test src/routes/cases.atomic.test.ts src/routes/cases.documents.test.ts src/routes/cases.send-report.test.ts src/routes/hearings.contract.test.ts src/routes/notifications.missed.test.ts src/routes/settings.test.ts src/lib/report-document-attachments.test.ts src/lib/mailer.test.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "openai": "^6.45.0",
    "pdfjs-dist": "^6.1.200",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "puppeteer-core": "^25.3.0",
    "resend": "^6.17.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "catalog:",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "supertest": "7.0.0",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
